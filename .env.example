# Origen público del sitio, sin barra final (por ejemplo https://tallami.com).
# Lo usan los metadatos (canonical, hreflang, Open Graph), el sitemap y robots.txt.
# Si falta, en Vercel se usa https://$VERCEL_PROJECT_PRODUCTION_URL (dominio de
# producción del proyecto) y, fuera de Vercel, http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- Panel de admin (/admin) ---------------------------------------------------
# Las dos las genera `npm run admin:password` (ver README, "Panel de admin").
# Cambiar el hash (o sea, la contraseña) cierra todas las sesiones abiertas.
# El hash lleva muchos "$": en un archivo .env van escritos con barra invertida
# (\$), que es como los imprime el script. En Vercel se pega tal cual.
#
# Hash scrypt de la contraseña del panel.
ADMIN_PASSWORD_HASH=
# Secreto que firma las sesiones y las IP de los intentos de ingreso y de los
# clics en "Reservar" del sitio (32 caracteres o más). Si lo cambiás, se cierran
# todas las sesiones. Sin él, el sitio público sigue igual pero no cuenta clics.
ADMIN_SESSION_SECRET=

# Base de datos del panel: URL de conexión de Supabase (pooler de transacciones).
# En Vercel es obligatoria. Sin ella, fuera de Vercel el panel usa una base
# local (PGlite) en .data/pglite.
DATABASE_URL=
# Carpeta de la base local (solo sin DATABASE_URL y fuera de Vercel).
# PGLITE_DIR=.data/pglite

# Avisos por email del panel (Resend): un email por cada ingreso y por cada cambio de
# seguridad (llaves, códigos, sesiones, bloqueos). Sin las dos primeras no se manda
# nada y Configuración → Seguridad dice "sin configurar". Nunca llevan contraseñas,
# códigos ni enlaces. Un fallo del email no frena ni rompe el ingreso: queda en los logs.
#
# Clave de la cuenta de Resend (resend.com → API Keys).
RESEND_API_KEY=
# A dónde llegan los avisos (tu email).
ADMIN_ALERT_EMAIL=
# Desde qué dirección salen. Por defecto la de prueba de Resend, que SOLO entrega al email
# de tu cuenta de Resend (alcanza si es el mismo que ADMIN_ALERT_EMAIL). Para usar otra
# hay que verificar un dominio propio en Resend, por ejemplo: Panel de Tallami <avisos@tu-dominio.com>
# ADMIN_ALERT_FROM=Panel de Tallami <onboarding@resend.dev>

# Dirección (origen) de las llaves de acceso del panel, SOLO para tests y desarrollo. Por
# defecto sale del sitio (NEXT_PUBLIC_SITE_URL, o el dominio de producción del proyecto en
# Vercel; http://localhost:3000 fuera de Vercel). La usan los servidores de los e2e (puertos
# 3100 a 3102) para llevar las llaves a su propia dirección; en producción de Vercel se
# ignora con un aviso en el log. No la definas en Vercel: movería las llaves a otra dirección.
# ADMIN_WEBAUTHN_ORIGIN=http://localhost:3100
