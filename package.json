{
  "name": "tallami-coaching",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test && playwright test -c playwright.demo.config.ts && playwright test -c playwright.security.config.ts",
    "test:e2e:main": "playwright test",
    "test:e2e:demo": "playwright test -c playwright.demo.config.ts",
    "test:e2e:security": "playwright test -c playwright.security.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "admin:password": "tsx scripts/admin-password.ts",
    "players:photo": "node scripts/fetch-player-photo.mjs",
    "tweets:record": "node scripts/record-tweet.mjs",
    "tweets:index": "node scripts/tweet-snapshots-index.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-tweet": "^3.3.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
