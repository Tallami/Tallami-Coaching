        "sales_item_valid": {
          "name": "sales_item_valid",
          "value": "\"sales\".\"item\" in ('vodRecorded', 'vodLive', 'lesson', 'lessonPack', 'gamePlan', 'tournament', 'proSeason', 'other')"
        },
        "sales_currency_valid": {
          "name": "sales_currency_valid",
          "value": "\"sales\".\"currency\" in ('USD', 'ARS', 'BRL', 'USDT')"
        },
        "sales_rate_source_valid": {
          "name": "sales_rate_source_valid",
          "value": "\"sales\".\"rate_source\" in ('bcra', 'manual', 'fixed')"
        },
        "sales_payment_method_valid": {
          "name": "sales_payment_method_valid",
          "value": "\"sales\".\"payment_method\" in ('mercadopago', 'pix', 'paypal', 'crypto', 'transfer', 'cash', 'other')"
        },
        "sales_status_valid": {
          "name": "sales_status_valid",
          "value": "\"sales\".\"status\" in ('pending', 'paid', 'delivered', 'cancelled', 'refunded')"
        },
        "sales_invoice_status_valid": {
          "name": "sales_invoice_status_valid",
          "value": "\"sales\".\"invoice_status\" in ('pending', 'issued', 'not_required')"
        },
        "sales_invoice_type_valid": {
          "name": "sales_invoice_type_valid",
          "value": "\"sales\".\"invoice_type\" is null or \"sales\".\"invoice_type\" in ('C', 'E')"
        },
        "sales_amount_positive": {
          "name": "sales_amount_positive",
          "value": "\"sales\".\"amount_minor\" > 0"
        },
        "sales_other_needs_description": {
          "name": "sales_other_needs_description",
          "value": "\"sales\".\"item\" <> 'other' or nullif(btrim(\"sales\".\"description\"), '') is not null"
        },
        "sales_paid_needs_paid_on": {
          "name": "sales_paid_needs_paid_on",
          "value": "\"sales\".\"status\" not in ('paid', 'delivered', 'refunded') or \"sales\".\"paid_on\" is not null"
        },
        "sales_issued_invoice_needs_data": {
          "name": "sales_issued_invoice_needs_data",
          "value": "\"sales\".\"invoice_status\" <> 'issued' or (\n        \"sales\".\"invoice_type\" is not null\n        and nullif(btrim(\"sales\".\"invoice_number\"), '') is not null\n        and \"sales\".\"invoiced_on\" is not null\n      )"
        }
      },
